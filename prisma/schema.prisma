generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String    @id @default(uuid())
  name     String
  email    String    @unique
  password String
  investiment Investiment[]
  account  Account[]
  createAt DateTime  @default(now())
}

model Account {
  id         String        @id @default(uuid())
  number     String        @unique
  type       AccountType   @default(CHECKING)
  ownerId    String
  owner      User          @relation(fields: [ownerId], references: [id])
  sentTx     Transaction[] @relation("SentTransactions")
  receivedTx Transaction[] @relation("ReceivedTransactions")
}

model Transaction {
  id            String          @id @default(uuid())
  type          TransactionType
  amount        Decimal         @db.Decimal(12, 2)
  fromAccountId String?
  toAccountId   String?
  createAt      DateTime        @default(now())
  fromAccount   Account?        @relation("SentTransactions", fields: [fromAccountId], references: [id])
  toAccount     Account?        @relation("ReceivedTransactions", fields: [toAccountId], references: [id])

  investimentId String?
  investiment Investiment? @relation(fields: [investimentId], references: [id])
}

enum AccountType {
  CHECKING
  SAVINGS
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER
  INVESTIMENT
  REDEMPTION
}

model Investiment {
  id String @id @default(uuid())
  amount Decimal @db.Decimal(12,2)
  yield Decimal @db.Decimal(12,2)
  createaAt DateTime @default(now())

  userId String
  user User @relation(fields: [userId], references: [id])

  transactions Transaction[]
}
